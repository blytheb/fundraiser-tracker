generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Team {
  id              String           @id @default(cuid())
  name            String
  status          TeamStatus       @default(IN_SEASON)
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  fundraiserTeams FundraiserTeam[]
  players         TeamPlayer[]
}

model Player {
  id                     String                  @id @default(cuid())
  firstName              String
  lastName               String
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  imageUrl               String?
  status                 Boolean                 @default(true)
  fundraiserParticipants FundraiserParticipant[]
  transactions           PlayerTransaction[]
  teams                  TeamPlayer[]
}

model TeamPlayer {
  id        String   @id @default(cuid())
  teamId    String
  playerId  String
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
}

model Fundraiser {
  id            String                   @id @default(cuid())
  name          String
  status        FundraiserStatus         @default(DRAFT)
  description   String
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  startDate     DateTime
  contributions FundraiserContribution[]
  participants  FundraiserParticipant[]
  teams         FundraiserTeam[]
}

model FundraiserContribution {
  id            String           @id @default(cuid())
  amount        Decimal          @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  source        ContributionType
  date          DateTime         @default(now())
  description   String?
  fundraiserId  String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  fundraiser    Fundraiser       @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)

  @@index([fundraiserId])
}

model FundraiserParticipant {
  id              String     @id @default(cuid())
  fundraiserId    String
  playerId        String
  createdAt       DateTime   @default(now())
  allocatedAmount Decimal    @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime   @default(now()) @updatedAt
  fundraiser      Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  player          Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([fundraiserId, playerId])
  @@index([fundraiserId])
}

model FundraiserTeam {
  id           String     @id @default(cuid())
  fundraiserId String
  teamId       String
  createdAt    DateTime   @default(now())
  fundraiser   Fundraiser @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([fundraiserId, teamId])
  @@index([teamId])
}

model PlayerTransaction {
  id          String                @id @default(cuid())
  playerId    String
  amount      Decimal               @db.Decimal(10, 2)
  type        PlayerTransactionType
  description String?
  date        DateTime              @default(now())
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  player      Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

enum TeamStatus {
  IN_SEASON
  SEASON_ENDED
}

enum FundraiserStatus {
  DRAFT
  COMPLETED
  PUBLISHED
}

enum ContributionType {
  SALES
  EVENT_PROFIT
  TIPS
  OTHER
}

enum PaymentMethod {
  CASH
  CHECK
  VENMO
  OTHER
}

enum PlayerTransactionType {
  EXPENSE
  PAYMENT
  ADJUSTMENT
  DISTRIBUTION
}
